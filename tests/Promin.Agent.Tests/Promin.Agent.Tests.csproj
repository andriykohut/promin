<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Promin.Agent.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Promin.Agent.Core\Promin.Agent.Core.csproj" />
    <ProjectReference Include="..\..\src\Promin.Agent\Promin.Agent.csproj" />
    <ProjectReference Include="..\..\src\Promin.Master.Core\Promin.Master.Core.csproj" />
  </ItemGroup>

  <!-- The console app cannot be referenced from here. Its end of a connection is compiled in, to meet the agent's over real QUIC. -->
  <ItemGroup>
    <Compile Include="..\..\src\Promin.Master\Services\QuicPcConnection.cs" Link="QuicPcConnection.cs" />
  </ItemGroup>

</Project>
