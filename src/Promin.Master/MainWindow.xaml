<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Promin.Master.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Promin.Master.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Promin"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            An absolute ms-appx URI: a Window has no base URI of its own, so a relative one
            cannot be resolved and the title bar showed a placeholder.
        -->
        <TitleBar x:Name="AppTitleBar" Title="Promin">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <!--
                A right header makes the bar tall, which drops it below the window buttons, and
                keeps 48 pixels of empty bar beside them. Keep the bar at their height and put
                the button against them; the window still drags by the rest of the bar.
            -->
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarExpandedHeight">32</x:Double>
                <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>
            </TitleBar.Resources>
            <!-- English and Українська name themselves, so each can be found from the other. -->
            <TitleBar.RightHeader>
                <Button
                    AutomationProperties.Name="{x:Bind core:Strings.Language}"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{x:Bind core:Strings.Language}">
                    <FontIcon FontSize="14" Glyph="&#xE774;" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="LanguageMenu" Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem
                                Click="OnLanguageChosen"
                                GroupName="Language"
                                Text="{x:Bind core:Strings.Language_System}" />
                            <RadioMenuFlyoutItem
                                Click="OnLanguageChosen"
                                GroupName="Language"
                                Tag="en"
                                Text="English" />
                            <RadioMenuFlyoutItem
                                Click="OnLanguageChosen"
                                GroupName="Language"
                                Tag="uk"
                                Text="Українська" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <!-- The one fault this PC can have of its own. Shows above both pages; never closable. -->
        <InfoBar
            Grid.Row="1"
            Margin="24,0,24,6"
            IsClosable="False"
            IsOpen="{x:Bind Health.HasLocalFault, Mode=OneWay}"
            Message="{x:Bind Health.LocalFaultMessage, Mode=OneWay}"
            Severity="Error"
            Title="{x:Bind Health.LocalFaultTitle, Mode=OneWay}"
            Visibility="{x:Bind Health.HasLocalFault, Mode=OneWay}" />

        <Frame x:Name="RootFrame" Grid.Row="2" />
    </Grid>
</Window>
