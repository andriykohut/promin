<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Promin.Master.Control.ControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="using:Promin.Master.Control"
    xmlns:core="using:Promin.Master.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The window form's strip (console-bar.html, section 2): the name, Full screen, Take control while viewing, Stop. -->
        <Grid
            x:Name="Strip"
            Padding="10,6"
            Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1"
            ColumnSpacing="8"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="StripName"
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Button Grid.Column="1" Click="FullScreen_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE740;" />
                    <TextBlock Text="{x:Bind core:Strings.Control_FullScreen}" />
                </StackPanel>
            </Button>
            <Button
                x:Name="StripTakeControl"
                Grid.Column="2"
                Click="TakeControl_Click"
                Content="{x:Bind core:Strings.View_TakeControl}" />
            <Button
                x:Name="StripStop"
                Grid.Column="3"
                Click="Stop_Click"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!--
            The other PC's screen. Its own pointer is drawn into the picture, so under control this PC's is hidden over it. The
            pointer events are taken by a grid around the panel: a SwapChainPanel is not hit-tested, and it refuses
            the background that would make it so (setting one fails the whole window's markup).
        -->
        <control:HiddenPointerArea
            x:Name="PointerArea"
            Grid.Row="1"
            Background="Transparent"
            PointerCaptureLost="Picture_PointerCaptureLost"
            PointerMoved="Picture_Pointer"
            PointerPressed="Picture_Pointer"
            PointerReleased="Picture_Pointer"
            PointerWheelChanged="Picture_PointerWheelChanged">
            <SwapChainPanel
                x:Name="Picture"
                CompositionScaleChanged="Picture_CompositionScaleChanged"
                SizeChanged="Picture_SizeChanged" />
        </control:HiddenPointerArea>

        <!-- A protected Windows screen on the other PC: its last picture stays, dimmed, under the reason. -->
        <Border
            x:Name="ProtectedLayer"
            Grid.Row="1"
            Background="#73000000"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ProtectedText"
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="White"
                Style="{StaticResource BodyTextBlockStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Border>

        <!-- The full-screen bar (console-bar.html, section 3, look B): it slides up out of sight, leaving the handle below. -->
        <Border
            x:Name="Bar"
            Grid.Row="1"
            Padding="12,4,6,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,8,8"
            PointerEntered="Bar_PointerEntered"
            PointerExited="Bar_PointerExited">
            <Border.TranslationTransition>
                <Vector3Transition />
            </Border.TranslationTransition>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    x:Name="BarName"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Button Click="InWindow_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE73F;" />
                        <TextBlock Text="{x:Bind core:Strings.Control_InWindow}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="BarTakeControl"
                    Click="TakeControl_Click"
                    Content="{x:Bind core:Strings.View_TakeControl}" />
                <Button
                    x:Name="BarStop"
                    Click="Stop_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
        <Border
            x:Name="Handle"
            Grid.Row="1"
            Width="70"
            Height="5"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,5,5"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
    </Grid>
</Window>
