<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Promin.Master.Pages.SendFilesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Promin.Master.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:Promin.Master.Pages"
    xmlns:sending="using:Promin.Master.Core.Sending"
    Title="{x:Bind core:Strings.Send_Title}"
    CloseButtonText="{x:Bind core:Strings.Cancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind Model.CanSend, Mode=OneWay}"
    PrimaryButtonClick="Send_Click"
    PrimaryButtonText="{x:Bind core:Strings.Send_Send}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <!-- The field labels at the left, in line with the first row of their field. -->
        <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- One row of the list: a file or folder glyph, the name, the size, an X. -->
        <DataTemplate x:Key="ItemTemplate" x:DataType="sending:SendListItem">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8A5;"
                    Visibility="{x:Bind pages:SendFilesDialog.IsFile(IsFolder)}" />
                <FontIcon
                    FontSize="16"
                    Foreground="#E8B64C"
                    Glyph="&#xE8B7;"
                    Visibility="{x:Bind IsFolder}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind SizeText}" />
                <Button
                    Grid.Column="3"
                    Width="28"
                    Height="28"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind core:Strings.Remove}"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Remove_Click">
                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Grid
        Width="472"
        ColumnSpacing="14"
        RowSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- What: Add, then the list with its total line, or the dashed box while nothing is added. -->
        <TextBlock Style="{StaticResource LabelStyle}" Text="{x:Bind core:Strings.Send_What}" />
        <StackPanel Grid.Column="1" Spacing="6">
            <DropDownButton Margin="0,0,0,2" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="{x:Bind core:Strings.Send_Add}" />
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuFlyoutItem Click="AddFiles_Click" Text="{x:Bind core:Strings.Send_AddFiles}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="AddFolder_Click" Text="{x:Bind core:Strings.Send_AddFolder}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Border
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{x:Bind Not(Model.IsEmpty), Mode=OneWay}">
                <StackPanel>
                    <ListView
                        MaxHeight="216"
                        ItemTemplate="{StaticResource ItemTemplate}"
                        ItemsSource="{x:Bind Model.Items}"
                        SelectionMode="None" />
                    <Border
                        Padding="12,5"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <TextBlock Style="{StaticResource HintStyle}" Text="{x:Bind Model.SummaryText, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Border>
            <Grid Visibility="{x:Bind Model.IsEmpty, Mode=OneWay}">
                <Rectangle
                    RadiusX="4"
                    RadiusY="4"
                    Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                    StrokeDashArray="4,3"
                    StrokeThickness="1" />
                <StackPanel Margin="16,22" Spacing="6">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="24"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind core:Strings.Send_Empty}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource HintStyle}" Text="{x:Bind core:Strings.Send_Where}" />
            <!-- A picked item that could not be read when Send was pressed. -->
            <InfoBar
                x:Name="SourceError"
                IsClosable="False"
                Severity="Error" />
        </StackPanel>

        <!-- To: the selected PCs or all of them, and which of those are offline. -->
        <TextBlock
            Grid.Row="1"
            Style="{StaticResource LabelStyle}"
            Text="{x:Bind core:Strings.Send_To}" />
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Spacing="4">
            <RadioButtons
                x:Name="To"
                MaxColumns="2"
                SelectionChanged="To_SelectionChanged">
                <RadioButton Content="{x:Bind Model.SelectedChoiceText}" IsEnabled="{x:Bind Model.CanChooseSelected}" />
                <RadioButton Content="{x:Bind Model.AllChoiceText}" />
            </RadioButtons>
            <TextBlock
                Style="{StaticResource HintStyle}"
                Text="{x:Bind Model.OfflineText, Mode=OneWay}"
                Visibility="{x:Bind NotEmpty(Model.OfflineText), Mode=OneWay}" />
        </StackPanel>

        <!-- Open on arrival, and what that does and does not do. -->
        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Spacing="4">
            <CheckBox Click="Open_Click" Content="{x:Bind core:Strings.Send_Open}" />
            <TextBlock Style="{StaticResource HintStyle}" Text="{x:Bind core:Strings.Send_OpenHelp}" />
        </StackPanel>
    </Grid>
</ContentDialog>
