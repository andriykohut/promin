<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Promin.Master.Pages.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:setup="using:Promin.Master.Core.Setup"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        </Style>
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SmallRingStyle" TargetType="ProgressRing">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="MinHeight" Value="16" />
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>

        <DataTemplate x:Key="ChecklistTemplate" x:DataType="setup:ChecklistItem">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Label}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource SecondaryTextStyle}"
                    TextWrapping="Wrap">
                    <Run
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind Lead}" /><Run Text="{x:Bind Rest}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate" x:DataType="setup:SetupRow">
            <Grid MinHeight="46">
                <!-- A failed row is tinted; nothing else about the row changes. -->
                <Border Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                <!-- The top separator; the page hides it on the first row. -->
                <Border
                    x:Name="RowSeparator"
                    Height="1"
                    VerticalAlignment="Top"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Padding="16,6,14,6" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE7F4;" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Address, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Status: a dot (or a ring while pairing), the status, and a reason under a failure. -->
                    <Grid
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind ShowsNeutralDot, Mode=OneWay}" />
                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{x:Bind ShowsSuccessDot, Mode=OneWay}" />
                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                            <ProgressRing
                                Width="14"
                                Height="14"
                                MinWidth="14"
                                MinHeight="14"
                                IsActive="{x:Bind IsPairing, Mode=OneWay}"
                                Visibility="{x:Bind IsPairing, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind StatusText, Mode=OneWay}"
                                Visibility="{x:Bind ShowsNeutralDot, Mode=OneWay}" />
                            <TextBlock
                                FontSize="13"
                                Text="{x:Bind StatusText, Mode=OneWay}"
                                Visibility="{x:Bind ShowsPlainStatus, Mode=OneWay}" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Text="{x:Bind StatusText, Mode=OneWay}"
                                Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind StatusDetail, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- One action per status; Waiting and Pairing have none. -->
                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <!-- Pair and Try again use the main field's code, so they need a valid one. -->
                        <Button
                            Click="Pair_Click"
                            Content="Pair"
                            IsEnabled="{x:Bind CanPairNow, Mode=OneWay}"
                            Visibility="{x:Bind ShowsPair, Mode=OneWay}" />
                        <Button
                            Click="EnterCode_Click"
                            Content="Enter its code"
                            IsEnabled="{x:Bind CanAct, Mode=OneWay}"
                            Visibility="{x:Bind ShowsEnterCode, Mode=OneWay}" />
                        <Button
                            Click="Pair_Click"
                            Content="Try again"
                            IsEnabled="{x:Bind CanPairNow, Mode=OneWay}"
                            Visibility="{x:Bind ShowsTryAgain, Mode=OneWay}" />
                        <Button
                            AutomationProperties.Name="More"
                            Style="{StaticResource IconButtonStyle}"
                            Visibility="{x:Bind ShowsMenu, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem
                                        Click="Rename_Click"
                                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                        Tag="{x:Bind}"
                                        Text="Rename" />
                                    <MenuFlyoutItem
                                        Click="Remove_Click"
                                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                        Tag="{x:Bind}"
                                        Text="Remove from this room" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,0,24,22" Spacing="14">

            <!-- 1. Back arrow and the title. -->
            <StackPanel
                Margin="0,6,0,-2"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    Margin="-8,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Back"
                    Click="Back_Click"
                    Style="{StaticResource IconButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                </Button>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Set up devices" />
            </StackPanel>

            <!--
                2. The result bar, when there is a result to report. Every bar on this page is
                also collapsed while closed: a closed InfoBar has no height but is still a child
                of the panel, which would otherwise leave its 14 px of spacing behind.
            -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsBannerOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}"
                Severity="{x:Bind SeverityOf(ViewModel.BannerKind), Mode=OneWay}"
                Title="{x:Bind ViewModel.BannerTitle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBannerOpen, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        Click="Back_Click"
                        Content="Go to This room"
                        Visibility="{x:Bind ViewModel.ShowsGoToRoom, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- What this PC could not do: read or save the room; look for PCs. Never closable. -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasStoreError, Mode=OneWay}"
                Message="{x:Bind ViewModel.StoreErrorMessage, Mode=OneWay}"
                Severity="Error"
                Title="{x:Bind ViewModel.StoreErrorTitle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasStoreError, Mode=OneWay}" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasDiscoveryError, Mode=OneWay}"
                Message="{x:Bind ViewModel.DiscoveryErrorMessage, Mode=OneWay}"
                Severity="Error"
                Title="{x:Bind ViewModel.DiscoveryErrorTitle, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasDiscoveryError, Mode=OneWay}" />

            <!-- 3. The room code card. -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ShowCodeCard, Mode=OneWay}">
                <!--
                    Two rows: the box shares the first with the left text and Pair all, exactly
                    as before; the hint has the second to itself, reserved whether or not it
                    shows, so nothing moves when it appears.
                -->
                <Grid Padding="18,16" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Room code" />
                        <TextBlock
                            MaxWidth="480"
                            Margin="0,2,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="The 6-digit code you chose when installing Promin on the student PCs."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <!--
                        The stock password box, untouched: nothing filters what is typed or
                        pasted, and nothing writes its content back in reaction to typing. The
                        code is checked on the action (RoomCode.TryNormalize); until it is valid
                        the actions stay disabled and the hint shows.
                    -->
                    <PasswordBox
                        x:Name="CodeBox"
                        Grid.Column="1"
                        MinWidth="160"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Room code"
                        InputScope="NumericPin"
                        PasswordChanged="CodeBox_PasswordChanged"
                        PasswordRevealMode="Peek"
                        PlaceholderText="6 digits" />
                    <!--
                        The hint keeps its line whether or not it shows: hidden by opacity, not
                        collapsed, and then out of the automation tree too. It is a polite live
                        region; the page raises the change event once when it appears.
                    -->
                    <TextBlock
                        x:Name="CodeHint"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4,0,0"
                        AutomationProperties.AccessibilityView="Raw"
                        AutomationProperties.LiveSetting="Polite"
                        IsHitTestVisible="False"
                        Opacity="0"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind ViewModel.CodeHint}" />
                    <Button
                        Grid.Column="2"
                        MinWidth="120"
                        Padding="20,8"
                        VerticalAlignment="Center"
                        Click="PairAll_Click"
                        IsEnabled="{x:Bind ViewModel.CanPairAll, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing
                                IsActive="{x:Bind ViewModel.IsPairing, Mode=OneWay}"
                                Style="{StaticResource SmallRingStyle}"
                                Visibility="{x:Bind ViewModel.IsPairing, Mode=OneWay}" />
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.PairAllLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <HyperlinkButton
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Click="Cancel_Click"
                        Content="Cancel"
                        Visibility="{x:Bind ViewModel.IsPairing, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- 4. Student PCs: the count, and Still looking at the right. -->
            <Grid Margin="0,4,0,-6" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SectionHeadingStyle}"
                    Text="Student PCs" />
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,0,1"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.ShowsStillLooking, Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind ViewModel.ShowsStillLooking, Mode=OneWay}" Style="{StaticResource SmallRingStyle}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Still looking" />
                </StackPanel>
            </Grid>

            <!-- 5. The list, one row per PC. -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                <ItemsRepeater
                    ElementIndexChanged="Rows_ElementIndexChanged"
                    ElementPrepared="Rows_ElementPrepared"
                    ItemTemplate="{StaticResource RowTemplate}"
                    ItemsSource="{x:Bind ViewModel.Rows}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </Border>

            <!-- 6. Nothing found yet (and discovery is running; otherwise the error bar above says why not). -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind ViewModel.ShowsLookingCard, Mode=OneWay}">
                <StackPanel Padding="24,34,24,30" HorizontalAlignment="Center">
                    <ProgressRing
                        Width="26"
                        Height="26"
                        MinWidth="26"
                        MinHeight="26"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Center"
                        IsActive="{x:Bind ViewModel.ShowsLookingCard, Mode=OneWay}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Looking for student PCs" />
                    <TextBlock
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="They appear here a few seconds after they start."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--
                7. A PC is missing? (design doc 6.6). The lines come from Core, where the port is
                ProminPorts.Quic and the wording is tested. Open by default while nothing is
                found; once a person has toggled it, it stays as they set it.
            -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="A PC is missing?"
                IsExpanded="{x:Bind ViewModel.IsChecklistExpanded, Mode=TwoWay}">
                <ItemsRepeater ItemTemplate="{StaticResource ChecklistTemplate}" ItemsSource="{x:Bind ViewModel.Checklist}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="5" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
