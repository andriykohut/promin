<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Promin.Master.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Promin.Master">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!--
                Signal orange from the Beacon identity, in place of the Windows accent. The dark
                theme fills with Light2 under black text, so that is Signal itself; the light theme
                fills with Dark1 under white text, which Signal is too pale for (3.1:1), so Dark1 is
                the nearest orange that reaches 4.5:1.
            -->
            <Color x:Key="SystemAccentColor">#FF5A1F</Color>
            <Color x:Key="SystemAccentColorLight1">#FF5A1F</Color>
            <Color x:Key="SystemAccentColorLight2">#FF5A1F</Color>
            <Color x:Key="SystemAccentColorLight3">#FF8A5C</Color>
            <Color x:Key="SystemAccentColorDark1">#D4420A</Color>
            <Color x:Key="SystemAccentColorDark2">#B23505</Color>
            <Color x:Key="SystemAccentColorDark3">#8A2803</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
