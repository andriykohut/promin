<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      What the agent and its window share: where the agent keeps its files and the room code file. No WinUI
      dependency, so that a plain xUnit project can test it.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Promin.Protocol\Promin.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every text the agent window shows. Strings.resx is English and the source; Strings.<language>.resx are translations. -->
    <EmbeddedResource Update="Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Promin.Agent.Core</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

</Project>
