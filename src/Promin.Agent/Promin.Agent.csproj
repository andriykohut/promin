<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Promin.Protocol\Promin.Protocol.csproj" />
    <ProjectReference Include="..\Promin.MediaPipeline\Promin.MediaPipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Promin.Agent.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!-- No console window, no taskbar button: the agent is invisible until a broadcast starts. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Per-monitor DPI awareness has to be declared before the first window exists, so it is in the manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The console's icon, so the exe is recognisable in Explorer and Task Manager. -->
    <ApplicationIcon>..\Promin.Master\Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
