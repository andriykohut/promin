<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Promin.Agent.Core\Promin.Agent.Core.csproj" />
    <ProjectReference Include="..\Promin.Protocol\Promin.Protocol.csproj" />
    <ProjectReference Include="..\Promin.MediaPipeline\Promin.MediaPipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.13" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The icon of the received-files notification (ReceivedNotice); the agent setup ships whatever the build puts beside the exe. -->
    <Content Include="..\..\installer\images\beacon-97.png" Link="Beacon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Promin.Agent.Tests" />
    <Using Include="Promin.Agent.Core" />
  </ItemGroup>

  <PropertyGroup>
    <!-- No console window, no taskbar button: the agent is invisible until a broadcast starts. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Per-monitor DPI awareness has to be declared before the first window exists, so it is in the manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The console's icon, so the exe is recognisable in Explorer and Task Manager. -->
    <ApplicationIcon>..\Promin.Master\Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
