<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Everything that decides what the console's screens say lives here, with no WinUI
      dependency, so that a plain xUnit project can test it. The WinUI project only binds.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Promin.Protocol\Promin.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessageFormat" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every text the console shows. Strings.resx is English and the source; Strings.<language>.resx are translations. -->
    <EmbeddedResource Update="Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Promin.Master.Core</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

</Project>
