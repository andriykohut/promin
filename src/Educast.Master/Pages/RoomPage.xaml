<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Educast.Master.Pages.RoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Educast.Master.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:video="using:Educast.Protocol.Video"
    xmlns:wall="using:Educast.Master.Core.Wall"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <!--
            A count pill: a capsule (the radius is half the fixed height; a larger radius is drawn as an ellipse),
            a dot coloured by its meaning, the count in the primary colour, the word secondary, normal weight.
        -->
        <DataTemplate x:Key="PillTemplate" x:DataType="wall:WallPill">
            <Border
                Height="28"
                Padding="12,0"
                VerticalAlignment="Center"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Ellipse
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        Fill="{x:Bind controls:PcTileColours.DotBrush(State)}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}">
                        <Run Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind Count}" /><Run Text=" " /><Run Text="{x:Bind Word}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TileTemplate" x:DataType="wall:PcTile">
            <controls:PcTileControl Tile="{x:Bind}" />
        </DataTemplate>

        <DataTemplate x:Key="PresetTemplate" x:DataType="video:QualityPreset">
            <TextBlock Text="{x:Bind Label}" />
        </DataTemplate>

        <DataTemplate x:Key="SharpnessTemplate" x:DataType="wall:SharpnessChoice">
            <TextBlock Text="{x:Bind Text}" />
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header: "This room", the count pills 12 px after it and 8 px apart, and Set up devices at the right. -->
        <Grid Padding="24,6,24,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="This room" />
            <ItemsRepeater
                Grid.Column="1"
                VerticalAlignment="Center"
                ItemTemplate="{StaticResource PillTemplate}"
                ItemsSource="{x:Bind ViewModel.Pills, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
            <HyperlinkButton
                Grid.Column="2"
                VerticalAlignment="Center"
                Click="SetUpDevices_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                    <TextBlock Text="Set up devices" />
                </StackPanel>
            </HyperlinkButton>
        </Grid>

        <!-- 2. The one message, never closable. -->
        <InfoBar
            Grid.Row="1"
            Margin="24,0,24,0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsMessageOpen, Mode=OneWay}"
            Message="{x:Bind ViewModel.MessageText, Mode=OneWay}"
            Severity="{x:Bind SeverityOf(ViewModel.MessageKind), Mode=OneWay}"
            Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button
                    Click="SetUpDevices_Click"
                    Content="{x:Bind ViewModel.MessageActionLabel, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasMessageAction, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- 3. The wall: a tile per PC, five per row at the default width, wrapping and scrolling. -->
        <ScrollViewer
            Grid.Row="2"
            Padding="24,14,24,22"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind Not(ViewModel.IsEmptyRoom), Mode=OneWay}">
            <ItemsRepeater
                x:Name="WallRepeater"
                ElementClearing="Wall_ElementClearing"
                ElementPrepared="Wall_ElementPrepared"
                ItemTemplate="{StaticResource TileTemplate}"
                ItemsSource="{x:Bind ViewModel.Tiles}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="14"
                        MinItemWidth="168"
                        MinRowSpacing="14" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty room (design doc 5.8). -->
        <Grid
            Grid.Row="2"
            Margin="24,14,24,22"
            Visibility="{x:Bind ViewModel.IsEmptyRoom, Mode=OneWay}">
            <Rectangle
                RadiusX="8"
                RadiusY="8"
                Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                StrokeDashArray="4,3"
                StrokeThickness="1" />
            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <FontIcon
                    FontSize="34"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE7F4;" />
                <TextBlock
                    Margin="0,10,0,4"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="No PCs in this room yet" />
                <TextBlock
                    MaxWidth="420"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Pair each student PC once. After that they appear here every time you open Educast."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    Padding="20,8"
                    HorizontalAlignment="Center"
                    Click="SetUpDevices_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                        <TextBlock Text="Set up devices" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 4. Action bar: the status, the quality picker, the button. -->
        <Grid
            Grid.Row="3"
            Padding="24,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse
                        x:Name="Pulse"
                        Width="9"
                        Height="9"
                        VerticalAlignment="Center"
                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.IsOnAir, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.BarLine1, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsOnAir, Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="SelectAll_Click"
                        Content="Select all"
                        Visibility="{x:Bind SelectionLinksVisibility(ViewModel.IsOnAir, ViewModel.IsEmptyRoom), Mode=OneWay}" />
                    <HyperlinkButton
                        Padding="0"
                        VerticalAlignment="Center"
                        Click="Clear_Click"
                        Content="Clear"
                        Visibility="{x:Bind SelectionLinksVisibility(ViewModel.IsOnAir, ViewModel.IsEmptyRoom), Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Margin="0,1,0,0"
                    FontSize="12.5"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.BarLine2, Mode=OneWay}" />
            </StackPanel>

            <!-- The quality picker off air; the same words as plain text on air. -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind Not(ViewModel.IsEmptyRoom), Mode=OneWay}">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="Quality"
                    Visibility="{x:Bind Not(ViewModel.IsOnAir), Mode=OneWay}" />
                <DropDownButton
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind ViewModel.QualityPickerName, Mode=OneWay}"
                    Content="{x:Bind ViewModel.QualityButtonText, Mode=OneWay}"
                    Visibility="{x:Bind Not(ViewModel.IsOnAir), Mode=OneWay}">
                    <DropDownButton.Flyout>
                        <Flyout Opening="Picker_Opening" Placement="Top">
                            <StackPanel Width="260" Spacing="12">
                                <RadioButtons
                                    x:Name="QualityRadios"
                                    Header="Quality"
                                    IsEnabled="{x:Bind ViewModel.CanChooseQuality, Mode=OneWay}"
                                    ItemTemplate="{StaticResource PresetTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Presets}"
                                    SelectionChanged="QualityRadios_SelectionChanged" />
                                <RadioButtons
                                    x:Name="SharpnessRadios"
                                    Header="Sharpness"
                                    ItemTemplate="{StaticResource SharpnessTemplate}"
                                    ItemsSource="{x:Bind ViewModel.SharpnessChoices, Mode=OneWay}"
                                    SelectionChanged="SharpnessRadios_SelectionChanged" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind ViewModel.NetworkLoadText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="{x:Bind ViewModel.QualityButtonText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsOnAir, Mode=OneWay}" />
            </StackPanel>

            <Button
                Grid.Column="2"
                Padding="24,10"
                FontSize="15"
                FontWeight="SemiBold"
                Click="Start_Click"
                IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind Not(ViewModel.IsOnAir), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                    <TextBlock Text="Start broadcast" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                Padding="24,10"
                FontSize="15"
                FontWeight="SemiBold"
                Click="Stop_Click"
                Visibility="{x:Bind ViewModel.IsOnAir, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon FontSize="14" Glyph="&#xE71A;" />
                    <TextBlock Text="Stop broadcast" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
