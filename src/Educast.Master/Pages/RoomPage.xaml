<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Educast.Master.Pages.RoomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: "This room", and Set up devices at the right. The count pills are Task 13. -->
        <Grid Padding="24,6,24,4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="This room" />
            <HyperlinkButton
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="SetUpDevices_Click">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                    <TextBlock Text="Set up devices" />
                </StackPanel>
            </HyperlinkButton>
        </Grid>

        <!-- Message area (design doc 5.6). For now only: the room file could not be read. -->
        <InfoBar
            Grid.Row="1"
            Margin="24,0,24,0"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasLoadError, Mode=OneWay}"
            Message="{x:Bind ViewModel.LoadErrorMessage, Mode=OneWay}"
            Severity="Error"
            Title="{x:Bind ViewModel.LoadErrorTitle, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasLoadError, Mode=OneWay}" />

        <!-- Empty room (design doc 5.8). -->
        <Grid
            Grid.Row="2"
            Margin="24,14,24,22"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <Rectangle
                RadiusX="8"
                RadiusY="8"
                Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                StrokeDashArray="4,3"
                StrokeThickness="1" />
            <StackPanel
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <FontIcon
                    FontSize="34"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE7F4;" />
                <TextBlock
                    Margin="0,10,0,4"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="No PCs in this room yet" />
                <TextBlock
                    MaxWidth="420"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Pair each student PC once. After that they appear here every time you open Educast."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    Padding="20,8"
                    HorizontalAlignment="Center"
                    Click="SetUpDevices_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon FontSize="14" Glyph="&#xE713;" />
                        <TextBlock Text="Set up devices" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- With members: one line where the wall will be. Task 13 replaces this with the wall. -->
        <TextBlock
            Grid.Row="2"
            Margin="24,14,24,22"
            Text="{x:Bind ViewModel.MemberCountText, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasMembers, Mode=OneWay}" />

        <!-- Action bar. Only the primary button exists yet; the rest is Task 13. -->
        <Grid
            Grid.Row="3"
            Padding="24,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="No PCs to broadcast to" />
                <TextBlock
                    Margin="0,1,0,0"
                    FontSize="12.5"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Set up devices to add the first one." />
            </StackPanel>
            <Button
                Grid.Column="1"
                Padding="24,10"
                FontSize="15"
                FontWeight="SemiBold"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                    <TextBlock Text="Start broadcast" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
