<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Educast.Master.Controls.PcTileControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Offline and Reconnecting: a diagonal hatch, 7 px of the control stroke, 7 px of the subtle fill. -->
        <LinearGradientBrush
            x:Key="HatchBrush"
            MappingMode="Absolute"
            SpreadMethod="Repeat"
            StartPoint="0,0"
            EndPoint="10,10">
            <GradientStop Offset="0" Color="{ThemeResource SubtleFillColorSecondary}" />
            <GradientStop Offset="0.5" Color="{ThemeResource SubtleFillColorSecondary}" />
            <GradientStop Offset="0.5" Color="{ThemeResource ControlStrokeColorDefault}" />
            <GradientStop Offset="1" Color="{ThemeResource ControlStrokeColorDefault}" />
        </LinearGradientBrush>
        <!-- Receiving: the accent at 15 %. -->
        <SolidColorBrush
            x:Key="ReceivingTintBrush"
            Opacity="0.15"
            Color="{ThemeResource SystemAccentColor}" />
        <Style x:Key="MenuRowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="Card"
        Padding="8,8,8,9"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Tapped="Card_Tapped">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="States">
                <VisualState x:Name="Ready" />
                <VisualState x:Name="Offline">
                    <VisualState.Setters>
                        <Setter Target="Screen.Background" Value="{StaticResource HatchBrush}" />
                        <Setter Target="Dot.Fill" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Receiving">
                    <VisualState.Setters>
                        <Setter Target="Screen.Background" Value="{StaticResource ReceivingTintBrush}" />
                        <Setter Target="MonitorGlyph.Visibility" Value="Collapsed" />
                        <Setter Target="CastGlyph.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DroppingFrames">
                    <VisualState.Setters>
                        <Setter Target="Screen.Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
                        <Setter Target="MonitorGlyph.Visibility" Value="Collapsed" />
                        <Setter Target="CastGlyph.Visibility" Value="Visible" />
                        <Setter Target="CastPath.Stroke" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="Card.BorderBrush" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="Card.BorderThickness" Value="2" />
                        <Setter Target="Card.Padding" Value="7,7,7,8" />
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
                        <Setter Target="Status.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Reconnecting">
                    <VisualState.Setters>
                        <Setter Target="Screen.Background" Value="{StaticResource HatchBrush}" />
                        <Setter Target="Card.BorderBrush" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="Card.BorderThickness" Value="2" />
                        <Setter Target="Card.Padding" Value="7,7,7,8" />
                        <Setter Target="Dot.Fill" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Setter Target="Status.Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="Selection">
                <VisualState x:Name="Unselected" />
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="Card.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="Card.BorderThickness" Value="2" />
                        <Setter Target="Card.Padding" Value="7,7,7,8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The screen area, 16:10 (the height follows the width in code-behind). Its one child
            holds the state glyph; a later sub-project puts a live preview there.
        -->
        <Grid
            x:Name="Screen"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="5"
            RenderTransformOrigin="0.5,0.5"
            SizeChanged="Screen_SizeChanged">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ScreenScale" />
            </Grid.RenderTransform>
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon
                    x:Name="MonitorGlyph"
                    FontSize="24"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE7F4;" />
                <!-- The cast glyph of the approved mockup, as a path (there is no such glyph in Segoe Fluent Icons). -->
                <Viewbox
                    x:Name="CastGlyph"
                    Width="26"
                    Height="26"
                    Visibility="Collapsed">
                    <Canvas Width="24" Height="24">
                        <Path
                            x:Name="CastPath"
                            Data="M4 19.2v.8 M4 15a5 5 0 0 1 5 5 M4 10.5A9.5 9.5 0 0 1 13.5 20 M4 6.5V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-1"
                            Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.8" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </Grid>

        <!-- The checkbox, top left of the screen area; off air only. -->
        <CheckBox
            MinWidth="0"
            MinHeight="0"
            Margin="6,6,0,0"
            Padding="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AutomationProperties.Name="Selected"
            Click="SelectBox_Click"
            IsChecked="{x:Bind Tile.IsSelected, Mode=OneWay}"
            IsEnabled="{x:Bind Tile.CanSelect, Mode=OneWay}"
            Visibility="{x:Bind Not(Tile.IsOnAir), Mode=OneWay}" />

        <!-- Name, and the details button at its right. -->
        <Grid
            Grid.Row="1"
            Margin="1,8,0,0"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Tile.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="More"
                Grid.Column="1"
                Width="24"
                Height="20"
                Padding="0"
                VerticalAlignment="Center"
                AutomationProperties.Name="More"
                Background="Transparent"
                BorderThickness="0"
                Click="More_Click"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <FontIcon FontSize="14" Glyph="&#xE712;" />
                <Button.Flyout>
                    <!-- Left of the tile; the flyout moves to the right by itself when there is no room. -->
                    <Flyout x:Name="Details" Placement="Left">
                        <StackPanel Width="300" Spacing="2">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind Tile.Name, Mode=OneWay}" />
                            <TextBlock
                                Margin="0,2,0,8"
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Tile.DetailSentence, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind NotEmpty(Tile.DetailSentence), Mode=OneWay}" />
                            <Grid
                                Padding="0,10"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1"
                                ColumnSpacing="14"
                                RowSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Frames dropped"
                                    Visibility="{x:Bind Tile.IsOnAir, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{x:Bind FramesText(Tile.FramesDropped, Tile.FramesOffered), Mode=OneWay}"
                                    TextAlignment="Right"
                                    Visibility="{x:Bind Tile.IsOnAir, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Row="1"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Receiving for"
                                    Visibility="{x:Bind Tile.IsOnAir, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{x:Bind Tile.ReceivingForText, Mode=OneWay}"
                                    TextAlignment="Right"
                                    Visibility="{x:Bind Tile.IsOnAir, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Row="2"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Address" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{x:Bind Tile.Address, Mode=OneWay}"
                                    TextAlignment="Right" />
                                <TextBlock
                                    Grid.Row="3"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Paired" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{x:Bind Tile.PairedOnText}"
                                    TextAlignment="Right" />
                            </Grid>
                            <StackPanel Margin="-8,8,-8,0">
                                <Button
                                    Click="StopSending_Click"
                                    Style="{StaticResource MenuRowStyle}"
                                    Visibility="{x:Bind IsBeingSentTo(Tile.State), Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon FontSize="14" Glyph="&#xE71A;" />
                                        <TextBlock Text="Stop sending to this PC" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Rename_Click" Style="{StaticResource MenuRowStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                        <TextBlock Text="Rename" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Click="Remove_Click"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource MenuRowStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                        <TextBlock Text="Remove from this room" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Status: a 7 px dot and the text. -->
        <StackPanel
            Grid.Row="2"
            Margin="1,0,0,0"
            Orientation="Horizontal"
            Spacing="6">
            <Ellipse
                x:Name="Dot"
                Width="7"
                Height="7"
                VerticalAlignment="Center"
                Fill="{ThemeResource SystemFillColorSuccessBrush}" />
            <TextBlock
                x:Name="Status"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Tile.StatusText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Grid>
</UserControl>
