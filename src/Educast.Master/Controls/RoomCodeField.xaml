<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Educast.Master.Controls.RoomCodeField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="False"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--
            The reveal button of the stock PasswordBox, copied from its template: the same glyph,
            size, margin and the same TextControlButton* theme brushes for rest, hover and press.
        -->
        <Style x:Key="RevealButtonStyle" TargetType="Button">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="Width" Value="30" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Padding" Value="{ThemeResource HelperButtonThemePadding}" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid
                            x:Name="ButtonLayoutGrid"
                            Margin="{ThemeResource TextBoxInnerButtonMargin}"
                            Background="{ThemeResource TextControlButtonBackground}"
                            BorderBrush="{ThemeResource TextControlButtonBorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonLayoutGrid.Background" Value="{ThemeResource TextControlButtonBackgroundPointerOver}" />
                                            <Setter Target="ButtonLayoutGrid.BorderBrush" Value="{ThemeResource TextControlButtonBorderBrushPointerOver}" />
                                            <Setter Target="GlyphElement.Foreground" Value="{ThemeResource TextControlButtonForegroundPointerOver}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ButtonLayoutGrid.Background" Value="{ThemeResource TextControlButtonBackgroundPressed}" />
                                            <Setter Target="ButtonLayoutGrid.BorderBrush" Value="{ThemeResource TextControlButtonBorderBrushPressed}" />
                                            <Setter Target="GlyphElement.Foreground" Value="{ThemeResource TextControlButtonForegroundPressed}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <TextBlock
                                x:Name="GlyphElement"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                FontSize="{ThemeResource PasswordBoxIconFontSize}"
                                FontStyle="Normal"
                                Foreground="{ThemeResource TextControlButtonForeground}"
                                IsTextScaleFactorEnabled="False"
                                Text="&#xF78D;" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        A masked field for the room code, in place of the stock PasswordBox, which cannot refuse
        an input before taking it and has no caret to restore (see RoomCodeField.xaml.cs). The
        TextBox holds one mask dot per digit (or the digits while the eye is held); the code
        itself lives only in the Code property, where the view model reads it. TextWrapping="Wrap"
        is what keeps the TextBox's own clear (X) button away, as a password field has none.
    -->
    <Grid>
        <!--
            Padding is the stock TextControlThemePadding (10,5,6,6) plus the 34 px the stock
            PasswordBox gives its reveal button (30 wide, 4 margin), which here sits over the box.
        -->
        <TextBox
            x:Name="Box"
            Padding="10,5,40,6"
            BeforeTextChanging="Box_BeforeTextChanging"
            InputScope="NumericPin"
            IsSpellCheckEnabled="False"
            IsTextPredictionEnabled="False"
            Paste="Box_Paste"
            PlaceholderText="6 digits"
            PreviewKeyDown="Box_PreviewKeyDown"
            TextChanged="Box_TextChanged"
            TextWrapping="Wrap" />
        <Button
            x:Name="RevealButton"
            AutomationProperties.Name="Show room code"
            Style="{StaticResource RevealButtonStyle}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
