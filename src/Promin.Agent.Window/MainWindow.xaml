<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Promin.Agent.Window.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Promin.Agent.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            An absolute ms-appx URI: a Window has no base URI of its own, so a relative one
            cannot be resolved and the title bar showed a placeholder.
        -->
        <TitleBar x:Name="AppTitleBar" Title="{x:Bind core:Strings.Window_Title}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <StackPanel Grid.Row="1" Margin="24,8,24,24">
            <TextBlock
                Margin="0,4,0,2"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{x:Bind core:Strings.Heading}" />
            <TextBlock
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind core:Strings.Intro}"
                TextWrapping="Wrap" />
            <TextBlock Margin="0,14,0,6" Text="{x:Bind core:Strings.RoomCode}" />
            <!--
                The stock text box, untouched: nothing filters what is typed or pasted. The code is
                checked on Save (AgentWindowModel.Save), and the bar below says what came of it.
            -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="CodeBox"
                    AutomationProperties.Name="{x:Bind core:Strings.RoomCode}"
                    InputScope="Number"
                    KeyDown="CodeBox_KeyDown"
                    PlaceholderText="{x:Bind core:Strings.CodePlaceholder}"
                    TextChanged="CodeBox_TextChanged" />
                <Button
                    x:Name="SaveButton"
                    Grid.Column="1"
                    MinWidth="80"
                    Click="Save_Click"
                    Content="{x:Bind core:Strings.Save}" />
            </Grid>
            <!-- Status and save errors share this one bar, so the window never grows. -->
            <InfoBar
                x:Name="StatusBar"
                Margin="0,14,0,0"
                IsClosable="False"
                IsOpen="True" />
        </StackPanel>
    </Grid>
</Window>
