<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      System.Net.Quic is annotated as supported on linux/macOS/windows only, and this project
      deliberately targets plain net10.0 (no Windows desktop dependency), so CA1416 fires on
      every QUIC call site. Educast ships on Windows 11 only, and QuicTransportSettings
      .EnsureSupported() fails loudly with a clear message wherever QUIC is unavailable.
    -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The tests reach the transport's internals: PeerCertificateStore.Pin (which only the
      pairing operation may call in production), the accept pump and the pairing trust window.
    -->
    <InternalsVisibleTo Include="Educast.Protocol.Tests" />
  </ItemGroup>

</Project>
