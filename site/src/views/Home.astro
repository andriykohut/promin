---
import { Image } from 'astro:assets';
import Beacon from '../../../assets/brand/promin-beacon-dark.svg';
import roomEn from '../../../assets/screenshots/room-en.png';
import roomUk from '../../../assets/screenshots/room-uk.png';
import Pc from '../components/Pc.astro';
import Base from '../layouts/Base.astro';
import { link, repo, strings, type Lang } from '../strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings[lang];
const screenshot = lang === 'uk' ? roomUk : roomEn;

// Each PC lights up when the sweeping beam reaches it, so its delay follows its angle from the beacon.
const pcs = Array.from({ length: 12 }, (_, i) => {
  const col = i % 4;
  const row = Math.floor(i / 4);
  const angle = (Math.atan2(-(col - 1.5), 0.7 + row * 0.75) * 180) / Math.PI;
  return (0.3 + (2.4 * (80 - angle)) / 160).toFixed(2);
});
---

<Base lang={lang} path="" title={t.title} description={t.description}>
  <div class="wrap hero" slot="masthead">
    <h1>{t.hero.title}</h1>
    <div>
      <p class="lead">{t.hero.lead}</p>
      <p class="actions">
        <a class="button" href="#download">{t.hero.download}</a>
        <a href={repo}>{t.hero.source}</a>
      </p>
    </div>

    <div class="room" role="img" aria-label={t.hero.roomLabel}>
      <Beacon class="beacon" />
      <div class="beam"></div>
      <div class="desks">
        {pcs.map((delay) => <Pc style={`--delay: ${delay}s`} />)}
      </div>
    </div>
  </div>

  <section class="features">
    <div class="wrap">
      <h2>{t.features.title}</h2>
      <div class="features-grid">
        <Image class="shot" src={screenshot} alt={t.features.screenshotAlt} widths={[640, 1264]} sizes="(min-width: 60rem) 34rem, 100vw" />
        <div>
          <dl class="feature-list">
            {
              t.features.items.map((item) => (
                <div>
                  <dt>{item.name}</dt>
                  <dd>{item.text}</dd>
                </div>
              ))
            }
          </dl>
          <p class="more"><a href={link(lang, 'features/')}>{t.features.more}</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="network">
    <div class="wrap">
      <h2>{t.network.title}</h2>
      <div class="network-points">
        {t.network.items.map((item) => <p>{item}</p>)}
      </div>
    </div>
  </section>

  <section class="setup">
    <div class="wrap">
      <h2>{t.setup.title}</h2>
      <ol class="steps">
        {
          t.setup.steps.map((step, i) => (
            <li>
              <h3>{step.name}</h3>
              <p>{step.text}</p>
              {i === 2 && (
                <div class="code" role="img" aria-label={t.setup.codeLabel}>
                  {[...'482913'].map((digit) => <span>{digit}</span>)}
                </div>
              )}
            </li>
          ))
        }
      </ol>
      <p class="more"><a href={link(lang, 'docs/')}>{t.setup.more}</a></p>
    </div>
  </section>

  <section class="download" id="download">
    <div class="wrap">
      <h2>{t.download.title}</h2>
      <div class="setups">
        <a class="setup-file" href={`${repo}/releases/latest/download/Promin-Console-Setup.exe`}>
          <span class="file-name">Promin-Console-Setup.exe</span>
          <span class="file-note">{t.download.consoleNote}</span>
        </a>
        <a class="setup-file" href={`${repo}/releases/latest/download/Promin-Agent-Setup.exe`}>
          <span class="file-name">Promin-Agent-Setup.exe</span>
          <span class="file-note">{t.download.agentNote}</span>
        </a>
      </div>
      <div class="notes">
        <p>{t.download.requirements}</p>
        <p>{t.download.sac} <a href={link(lang, 'docs/smart-app-control/')}>{t.download.sacLink}</a></p>
        <p>{t.download.smartScreen}</p>
        <p><a href={`${repo}/releases`}>{t.download.releases}</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 3rem;
    align-items: center;
    padding-top: clamp(2rem, 6vw, 5rem);
    padding-bottom: var(--section);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 5fr 6fr;
      gap: 3rem 4rem;
    }
  }

  /* Spans both columns: the display face is wide, and Ukrainian runs longer than English. */
  h1 {
    grid-column: 1 / -1;
  }

  .actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
  }

  .button {
    display: inline-block;
    padding: 0.875rem 1.75rem;
    border-radius: 999px;
    background: var(--beam);
    color: var(--night);
    font-family: var(--font-display);
    font-weight: 500;
    text-decoration: none;
  }

  .button:hover {
    background: var(--fog);
  }

  .room {
    position: relative;
    padding-top: clamp(5.5rem, 11vw, 8rem);
  }

  .beacon {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    width: clamp(5.5rem, 11vw, 8rem);
    height: auto;
    z-index: 2;
  }

  .beam {
    position: absolute;
    /* The lamp sits 15/64 of the way down the beacon artwork. */
    top: calc(clamp(5.5rem, 11vw, 8rem) * 15 / 64);
    left: 50%;
    width: 140%;
    height: 110%;
    transform-origin: 50% 0;
    background: linear-gradient(to bottom, rgb(255 90 31 / 0.6), rgb(255 90 31 / 0));
    clip-path: polygon(50% 0, 38% 100%, 62% 100%);
    mix-blend-mode: screen;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    animation: sweep 2.4s linear 0.3s both;
  }

  @keyframes sweep {
    0% {
      transform: translateX(-50%) rotate(80deg);
      opacity: 0;
    }
    10%,
    85% {
      opacity: 1;
    }
    100% {
      transform: translateX(-50%) rotate(-80deg);
      opacity: 0;
    }
  }

  .desks {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.75rem, 2.2vw, 1.5rem) clamp(0.5rem, 1.8vw, 1.25rem);
  }

  .desks :global(.pc) {
    box-shadow: 0 0 1.75rem -0.5rem rgb(255 90 31 / 0.4);
    animation: catch 0.9s ease-out var(--delay) both;
  }

  .desks :global(.screen)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--screen-off);
    opacity: 0;
    animation: power-on 0.35s ease-out var(--delay) both;
  }

  @keyframes power-on {
    from {
      opacity: 1;
    }
  }

  @keyframes catch {
    from {
      box-shadow: 0 0 0 0 rgb(255 90 31 / 0);
    }
    30% {
      box-shadow: 0 0 2.5rem 0.25rem rgb(255 90 31 / 0.75);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .beam,
    .desks :global(.pc),
    .desks :global(.screen)::after {
      animation: none;
    }
  }

  section {
    padding-block: var(--section);
  }

  .more {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-weight: 500;
  }

  .features-grid {
    display: grid;
    gap: 3rem;
    margin-top: 3rem;
  }

  @media (min-width: 60rem) {
    .features-grid {
      grid-template-columns: 34rem minmax(0, 1fr);
      align-items: start;
      gap: 4rem;
    }

    .shot {
      position: sticky;
      top: 2rem;
    }
  }

  .shot {
    width: 100%;
    height: auto;
    border-radius: 8px;
    outline: 1px solid rgb(20 21 24 / 0.15);
  }

  .feature-list {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 2.25rem;
  }

  dt {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.3;
  }

  dd {
    margin: 0.5rem 0 0;
    color: var(--steel);
    max-width: 36ch;
  }

  .network {
    background: var(--night);
    color: var(--fog);
  }

  .network-points {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
    color: var(--haze);
  }

  @media (min-width: 50rem) {
    .network-points {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .network-points p {
    max-width: 36ch;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 50rem) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .steps li {
    counter-increment: step;
    border-top: 4px solid var(--beam);
    padding-top: 1.25rem;
  }

  .steps li::before {
    content: counter(step);
    display: block;
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 1.25rem;
  }

  .steps p {
    margin-top: 0.625rem;
    color: var(--steel);
    max-width: 38ch;
    overflow-wrap: anywhere;
  }

  .code {
    display: flex;
    gap: 0.375rem;
    margin-top: 1.5rem;
  }

  .code span {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 3.25rem;
    border: 2px solid var(--night);
    border-radius: 6px;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 500;
  }

  .download {
    background: var(--beam);
  }

  .download a:not(.setup-file) {
    text-decoration-color: var(--night);
  }

  .download :focus-visible {
    outline-color: var(--night);
  }

  .setups {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 50rem) {
    .setups {
      grid-template-columns: 1fr 1fr;
      max-width: 52rem;
    }
  }

  .setup-file {
    display: grid;
    gap: 0.25rem;
    padding: 1.5rem 1.75rem;
    border-radius: 8px;
    background: var(--night);
    color: var(--fog);
    text-decoration: none;
  }

  .setup-file:hover {
    background: var(--slate);
  }

  .file-name {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 2vw, 1.125rem);
    font-weight: 500;
    overflow-wrap: anywhere;
  }

  .file-note {
    color: var(--haze);
  }

  .notes {
    display: grid;
    gap: 0.875rem;
    margin-top: 2.5rem;
    max-width: 44rem;
  }
</style>
