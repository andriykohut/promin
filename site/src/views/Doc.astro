---
import { render, type CollectionEntry } from 'astro:content';
import { docPath, docsIn } from '../docs';
import Base from '../layouts/Base.astro';
import { link, strings, type Lang } from '../strings';

interface Props {
  lang: Lang;
  doc: CollectionEntry<'docs'>;
}

const { lang, doc } = Astro.props;
const t = strings[lang];
const pages = await docsIn(lang);
const { Content } = await render(doc);
const path = docPath(doc);
---

<Base lang={lang} path={path} title={`${doc.data.title} | ${t.docs.titleSuffix}`} description={t.description}>
  <div class="wrap docs">
    <nav class="pages" aria-label={t.docs.navLabel}>
      <ul>
        {
          pages.map((page) => (
            <li>
              <a href={link(lang, docPath(page))} aria-current={page.id === doc.id ? 'page' : undefined}>
                {page.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <article class="prose">
      <h1>{doc.data.title}</h1>
      <Content />
    </article>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) var(--section);
  }

  @media (min-width: 56rem) {
    .docs {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 4rem;
    }

    .pages {
      position: sticky;
      top: 2rem;
      align-self: start;
    }
  }

  .pages ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }

  .pages a {
    display: block;
    padding: 0.5rem 0.875rem;
    border-left: 3px solid transparent;
    text-decoration: none;
    color: var(--steel);
    line-height: 1.35;
  }

  .pages a:hover {
    color: var(--night);
  }

  .pages a[aria-current='page'] {
    border-left-color: var(--beam);
    color: var(--night);
    font-weight: 600;
  }

  .prose {
    min-width: 0;
    max-width: 46rem;
  }

  .prose h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1.75rem;
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    max-width: none;
    margin: 2.75rem 0 1rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(table) {
    margin: 0 0 1.125rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
  }

  .prose :global(li + li) {
    margin-top: 0.375rem;
  }

  .prose :global(li::marker) {
    color: var(--beam);
    font-family: var(--font-display);
  }

  .prose :global(code) {
    font-family: Consolas, ui-monospace, monospace;
    font-size: 0.9em;
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: rgb(20 21 24 / 0.07);
    overflow-wrap: anywhere;
  }

  .prose :global(pre) {
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    line-height: 1.5;
  }

  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.625rem 1rem 0.625rem 0;
    border-bottom: 1px solid rgb(20 21 24 / 0.15);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    font-weight: 600;
  }

  /* Commands and port numbers in a table's first column read wrong when split. */
  .prose :global(td:first-child code) {
    white-space: nowrap;
  }
</style>
